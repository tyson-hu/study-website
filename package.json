{
  "name": "study-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npm run preview",
    "preview": "wrangler pages dev out",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "tsx --test tests/*.test.ts",
    "verify:data": "node scripts/verify-question-sets.mjs",
    "validate": "npm run lint && npm run typecheck && npm test && npm run verify:data && npm run build",
    "pages:build": "npm run build",
    "pages:deploy": "npm run pages:build && wrangler pages deploy out --project-name=study-web",
    "pages:preview": "npm run preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.22.0",
    "motion": "^12.42.2",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "shadcn": "^4.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "wrangler": "4.123.0"
  }
}
